LIBREEYES_ENV=development
LIBREEYES_HTTP_ADDR=:8080
LIBREEYES_DATABASE_URL=postgres://libreeyes:libreeyes_dev@localhost:5432/libreeyes?sslmode=disable
LIBREEYES_COOKIE_SECURE=false
LIBREEYES_CSRF_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
LIBREEYES_SESSION_IDLE_TIMEOUT=15m
LIBREEYES_SESSION_ABSOLUTE_TIMEOUT=12h
LIBREEYES_LOGIN_FAILURE_LIMIT=5
LIBREEYES_SOFT_LOCK_DURATION=15m
LIBREEYES_SHUTDOWN_TIMEOUT=10s
