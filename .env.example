VISIONOPUS_ENV=development
VISIONOPUS_HTTP_ADDR=:8080
VISIONOPUS_DATABASE_URL=postgres://visionopus:visionopus_dev@localhost:5432/visionopus?sslmode=disable
VISIONOPUS_COOKIE_SECURE=false
VISIONOPUS_CSRF_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
VISIONOPUS_SESSION_IDLE_TIMEOUT=15m
VISIONOPUS_SESSION_ABSOLUTE_TIMEOUT=12h
VISIONOPUS_LOGIN_FAILURE_LIMIT=5
VISIONOPUS_SOFT_LOCK_DURATION=15m
VISIONOPUS_SHUTDOWN_TIMEOUT=10s
